.{
    .name = "Leyernet",
    .version = "0.01",
    .minimum_zig_version = "0.13.0",

    .dependencies = .{
        .file_dependence = .{
            .file_UNIX = "binarys/MACHINE",
            .file_UNIX_2 = "binarys/HUMAN",
        },
    },
    .class = .{
        .gcc = "ASM",
        .clang = "ASM",
        .nasm = "s",
    },

    .lib = .{
        .Lib = "src/Lib/big_g.cpp",
        .Lib = "src/Lib/kasm.S",
        .Lib = "src/Lib/lib.c",
    }

    .paths = .{
        "src",
        "Alloxer.zon",
        "Compiler",
        "LICENSE",
    },
}